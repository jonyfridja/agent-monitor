{
  "name": "agent-monitor",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.12.0",
  "engines": { "node": ">=24" },
  "scripts": {
    "test": "node --test \"packages/*/src/**/*.test.ts\" \"apps/*/src/**/*.test.ts\" \"scripts/*.test.mjs\"",
    "stop": "node scripts/stop.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "server": "node packages/server/src/cli.ts",
    "host": "pnpm --filter @agent-monitor/host dev",
    "package": "pnpm --filter @agent-monitor/host package"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
