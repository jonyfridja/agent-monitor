{
  "name": "agent-monitor",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "node scripts/test.mjs",
    "test:coverage": "node scripts/test.mjs --coverage",
    "stop": "node scripts/stop.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "host": "node apps/host/scripts/launch.mjs",
    "hooks": "node scripts/hooks.mjs",
    "package": "pnpm --filter @agent-monitor/host package"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
